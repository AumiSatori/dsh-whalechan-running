{
  "name": "dsh-whalechan-running",
  "version": "0.2.0",
  "description": "把 DSH 聊天界面「深度求索中」旁边那条鲸鱼尾巴剪影，换成会随机换动作的彩色动图（内置 50 个鲸鱼娘动作池，也可指向任意目录当池子）；尺寸、池路径、随机方式都走配置文件，插件停用即恢复原样",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "whale",
    "whalechan",
    "apng",
    "theme",
    "pool",
    "random",
    "webm"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.png",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
